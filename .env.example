# Copie este arquivo para .env (ou exporte as variáveis no shell) antes de
# rodar a aplicação localmente.

# Porta HTTP da aplicação
PORT=8080

# Datasource (Postgres) — UMA base física compartilhada por todos os
# microsserviços (ver /Users/igorlima/Documents/gestão-condial/infra/README.md
# para subir via docker-compose ou usar um Postgres nativo local). O que
# diferencia cada serviço é DB_SCHEMA, nunca DB_NAME.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestao_condial
DB_USER=postgres
DB_PASSWORD=postgres

# Schema próprio deste serviço no Postgres (hibernate.default_schema e
# flyway.schemas)
DB_SCHEMA=auto_gestao

# OAuth2 Resource Server — issuer do gestao-condial-oauth-service. Placeholder
# até o serviço real estar no ar.
OAUTH_ISSUER_URI=http://localhost:8081
